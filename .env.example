# =====================================================================
# ROBÔ DE INVESTIMENTOS - configuração
# Copie este arquivo para ".env" e preencha. NUNCA compartilhe o .env.
# =====================================================================

# --- Login do painel ---
# Coloque o seu e-mail. A senha inicial só vale até o 1º acesso (o sistema obriga a troca).
# Se deixar a senha vazia, uma aleatória é gerada e mostrada no terminal.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
PORT=8000
# true quando estiver atrás do Caddy/HTTPS (produção)
TRUST_PROXY=false

# --- Modo ---
# paper = simulação com dinheiro fictício (comece SEMPRE por aqui)
# live  = dinheiro real
TRADING_MODE=paper

# --- Mercado principal ---
# synthetic = mercado de mentira para testar o sistema sem internet
# crypto    = criptomoedas 24h (Binance e outras)
# mt5       = B3 via MetaTrader 5 (só no Windows)
BROKER=crypto

# Ativos (cripto: BTC/USDT,ETH/USDT | B3: PETR4,VALE3,WINZ26)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
LOOP_SECONDS=60
HISTORY_BARS=1000
INITIAL_CAPITAL=10000
QUOTE_CURRENCY=USDT
FEE_RATE=0.001
SLIPPAGE=0.0005

# --- Cripto (ccxt) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
# true = testnet da Binance (dinheiro de teste)
EXCHANGE_TESTNET=true

# --- B3 / MetaTrader 5 (Windows) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Bolsa dos EUA + Pesquisa (trader-skill integrado) ---
US_ENABLED=true
US_INITIAL_CAPITAL=5000
ALPACA_API_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true
# A SEC exige identificação: "Seu Nome seu@email.com"
SEC_USER_AGENT=

# --- Telegram (aprovar ordens pelo celular) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=data/robo.db
