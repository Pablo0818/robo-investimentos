# ===== Configuração pronta para a VPS Hostinger =====
# ADMIN_EMAIL e DOMAIN são preenchidos pelo instalador.
# A senha inicial vale só até o 1º acesso: lá o sistema obriga a troca.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
DOMAIN=

# Começa em SIMULAÇÃO com preços reais de cripto (24h). Não precisa de chaves.
TRADING_MODE=paper
BROKER=crypto
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
LOOP_SECONDS=60
HISTORY_BARS=999
INITIAL_CAPITAL=10000
QUOTE_CURRENCY=USDT
FEE_RATE=0.001
SLIPPAGE=0.0005
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_TESTNET=true

# EUA + pesquisa (trader-skill)
US_ENABLED=true
US_INITIAL_CAPITAL=5000
ALPACA_API_KEY=
ALPACA_SECRET=
ALPACA_PAPER=true
SEC_USER_AGENT=

# Telegram (preencha depois)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8000
TRUST_PROXY=true
DB_PATH=data/robo.db
